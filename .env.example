# Copy to .env and fill in. Required values stop the server at startup if missing.

# Required: Postgres with the pgvector extension (e.g. the pgvector/pgvector Docker image, or Neon).
# On hosted databases use the direct (non-pooled) connection string, migrations need it.
DATABASE_URL=postgresql://postgres:password@localhost:5433/mydb

# Required: signs login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional: YouTube Data API v3 key. Without it, videos are only searchable by title.
YOUTUBE_API_KEY=

# Optional: Anthropic API key for "Ask your brain". Without it, Ask returns 503.
ANTHROPIC_API_KEY=

# Optional: port to listen on (hosts usually set this for you)
PORT=3000
